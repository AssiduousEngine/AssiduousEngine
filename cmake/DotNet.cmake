# C# compiled ahead of time into a program (an exported player, a test).
#
# dotnet_link_compiled_runtime(<target> <name> <sources folder>): the engine's managed runtime, its
# bindings and every .cs under <sources folder> (an IDE's bin and obj passed over) compiled into one
# static library linked into <target>, whose C# backend then calls it instead of starting .NET (see
# DotNetCompiledIn.cpp). Every type is kept through trimming, since behaviours are called by
# reflection. The desktop compiles with NativeAOT (Linux for now); the web with NativeAOT-LLVM
# (browser-wasm), whose bitcode is built with the emsdk it was made with (DOTNET_EMSDK) and linked by
# the engine's own.

find_program(DOTNET_EXECUTABLE dotnet REQUIRED)
set(DOTNET_RUNTIME_SOURCE ${CMAKE_SOURCE_DIR}/Code/Foundation/Script.DotNet/Managed)
if(EMSCRIPTEN)
    # A web build cannot run the bindings generator (its tools are wasm): a desktop build's, staged
    # beside its runtime (Bin/.../DotNet/Engine.g.cs), is given. Their layouts hold on wasm32: fields
    # sit where they do on the desktop, and an opaque value is sized for 64-bit and checked at start.
    set(DOTNET_BINDINGS "" CACHE FILEPATH "The C# bindings a desktop build generated (its DotNet/Engine.g.cs)")
    set(DOTNET_EMSDK "$ENV{HOME}/emsdk-3.1.56" CACHE PATH "The emsdk NativeAOT-LLVM's bitcode is built with")
    set(DOTNET_LLVM_VERSION "10.0.0-rc.1.26357.1" CACHE STRING "Microsoft.DotNet.ILCompiler.LLVM's version")
    set(DOTNET_RUNTIME_BINDINGS ${DOTNET_BINDINGS})
endif()

function(dotnet_link_compiled_runtime target name sources)
    set(dir ${CMAKE_CURRENT_BINARY_DIR}/${name})
    set(out ${dir}/out)
    set(project ${dir}/Engine.Runtime.csproj)
    file(GLOB_RECURSE application_sources CONFIGURE_DEPENDS ${sources}/*.cs)
    list(FILTER application_sources EXCLUDE REGEX "/(bin|obj)/")
    set(compile_items "    <Compile Include=\"${DOTNET_RUNTIME_SOURCE}/Bridge.cs\" />
    <Compile Include=\"${DOTNET_RUNTIME_SOURCE}/Runtime.cs\" />
    <Compile Include=\"${DOTNET_RUNTIME_SOURCE}/ValueMath.cs\" />
    <Compile Include=\"${DOTNET_RUNTIME_BINDINGS}\" />
    <Compile Include=\"${sources}/**/*.cs\" Exclude=\"${sources}/**/bin/**;${sources}/**/obj/**\" />
    <TrimmerRootAssembly Include=\"Engine.Runtime\" />")
    set(common "    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Engine.Runtime</AssemblyName>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NativeLib>Static</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);IL2026;IL2072;IL2075;IL2070;IL2067;IL2057;IL3050</NoWarn>")
    if(EMSCRIPTEN)
        file(WRITE ${project} "<Project Sdk=\"Microsoft.NET.Sdk\">
  <!-- Generated by dotnet_link_compiled_runtime: the engine's managed runtime and an application, as LLVM bitcode for the web. -->
  <PropertyGroup>
${common}
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <InvariantTimezone>true</InvariantTimezone>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <DebugType>none</DebugType>
    <WasmEnableExceptionHandling>false</WasmEnableExceptionHandling>
    <IlcLlvmExceptionHandlingModel>emulated</IlcLlvmExceptionHandlingModel>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
${compile_items}
    <PackageReference Include=\"Microsoft.DotNet.ILCompiler.LLVM\" Version=\"${DOTNET_LLVM_VERSION}\" />
    <PackageReference Include=\"runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM\" Version=\"${DOTNET_LLVM_VERSION}\" />
  </ItemGroup>
  <!-- What the program links beside the bitcode: the runtime's libraries, from the package it used. -->
  <Target Name=\"WriteEngineLinkInputs\" AfterTargets=\"LinkNativeLlvm\">
    <ItemGroup>
      <EngineLink Include=\"-Wl,--whole-archive\" />
      <EngineLink Include=\"$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(NativeBinary)))\" />
      <EngineLink Include=\"-Wl,--no-whole-archive\" />
      <EngineLink Include=\"@(NativeLibrary->'%(FullPath)')\" />
      <EngineLink Include=\"$(IlcSdkPath)libStackTraceIpCanary.o\" Condition=\"Exists('$(IlcSdkPath)libStackTraceIpCanary.o')\" />
    </ItemGroup>
    <WriteLinesToFile File=\"${out}/link.rsp\" Lines=\"@(EngineLink)\" Overwrite=\"true\" WriteOnlyWhenDifferent=\"true\" />
  </Target>
  <!-- A static library makes no page, but publish copies the .js and .wasm it expects: empty ones. -->
  <Target Name=\"StubPageFiles\" BeforeTargets=\"CopyNativeBinary\">
    <Touch Files=\"$(NativeOutputPath)$(TargetName).js;$(NativeOutputPath)$(TargetName).wasm\" AlwaysCreate=\"true\" />
  </Target>
</Project>
")
        set(library ${out}/link.rsp)
        add_custom_command(
            OUTPUT ${out}/link.rsp
            COMMAND bash -c "source '${DOTNET_EMSDK}/emsdk_env.sh' >/dev/null 2>&1 && '${DOTNET_EXECUTABLE}' publish '${project}' -c Release -r browser-wasm -o '${out}/publish' -p:EMSDK='${DOTNET_EMSDK}' -p:BaseIntermediateOutputPath='${dir}/obj/' -nologo -v:q --disable-build-servers"
            DEPENDS ${project} ${application_sources} ${DOTNET_RUNTIME_SOURCE}/Bridge.cs ${DOTNET_RUNTIME_SOURCE}/Runtime.cs ${DOTNET_RUNTIME_SOURCE}/ValueMath.cs
                    ${DOTNET_RUNTIME_BINDINGS}
            COMMENT "Compiling the managed runtime and ${name} to bitcode for the web (NativeAOT-LLVM)"
            VERBATIM)
        add_custom_target(${name}.CompiledRuntime DEPENDS ${out}/link.rsp)
        # The runtime's JavaScript side reads the heap views (a stack trace, for one).
        target_link_options(${target} PRIVATE
            "-sEXPORTED_RUNTIME_METHODS=HEAP8,HEAPU8,HEAP16,HEAPU16,HEAP32,HEAPU32,HEAPF32,HEAPF64")
    else()
        file(WRITE ${project} "<Project Sdk=\"Microsoft.NET.Sdk\">
  <!-- Generated by dotnet_link_compiled_runtime: the engine's managed runtime and an application, compiled ahead of time. -->
  <PropertyGroup>
${common}
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
${compile_items}
  </ItemGroup>
  <!-- What the program links beside the library: NativeAOT's runtime, from the package it used. -->
  <Target Name=\"WriteEngineLinkInputs\" AfterTargets=\"Publish\">
    <ItemGroup>
      <EngineLink Include=\"-Wl,--whole-archive\" />
      <EngineLink Include=\"${out}/Engine.Runtime.a\" />
      <EngineLink Include=\"-Wl,--no-whole-archive\" />
      <EngineLink Include=\"-Wl,--start-group\" />
      <EngineLink Include=\"$(IlcSdkPath)libbootstrapperdll.o\" />
      <EngineLink Include=\"$(IlcSdkPath)libRuntime.WorkstationGC.a;$(IlcSdkPath)libeventpipe-disabled.a;$(IlcSdkPath)libstandalonegc-disabled.a;$(IlcSdkPath)libRuntime.VxsortDisabled.a;$(IlcSdkPath)libaotminipal.a\" />
      <EngineLink Include=\"$(IlcFrameworkNativePath)libSystem.Native.a;$(IlcFrameworkNativePath)libstdc++compat.a;$(IlcFrameworkNativePath)libbrotlienc.a;$(IlcFrameworkNativePath)libbrotlidec.a;$(IlcFrameworkNativePath)libbrotlicommon.a;$(IlcFrameworkNativePath)libz.a\" />
      <EngineLink Include=\"-Wl,--end-group\" />
      <EngineLink Include=\"-ldl;-lm;-lrt;-lpthread\" />
    </ItemGroup>
    <WriteLinesToFile File=\"${out}/link.rsp\" Lines=\"@(EngineLink)\" Overwrite=\"true\" WriteOnlyWhenDifferent=\"true\" />
  </Target>
</Project>
")
        set(library ${out}/Engine.Runtime.a)
        add_custom_command(
            OUTPUT ${out}/Engine.Runtime.a ${out}/link.rsp
            COMMAND ${DOTNET_EXECUTABLE} publish ${project} -c Release -o ${out}
                    -p:BaseIntermediateOutputPath=${dir}/obj/ -nologo -v:q --disable-build-servers
            DEPENDS ${project} ${application_sources} ${DOTNET_RUNTIME_SOURCE}/Bridge.cs ${DOTNET_RUNTIME_SOURCE}/Runtime.cs ${DOTNET_RUNTIME_SOURCE}/ValueMath.cs
                    ${DOTNET_RUNTIME_BINDINGS}
            COMMENT "Compiling the managed runtime and ${name} ahead of time")
        add_custom_target(${name}.CompiledRuntime DEPENDS ${out}/Engine.Runtime.a ${out}/link.rsp)
        add_dependencies(${name}.CompiledRuntime DotNet.Runtime) # the bindings, generated there
    endif()
    add_dependencies(${target} ${name}.CompiledRuntime)
    target_link_options(${target} PRIVATE "@${out}/link.rsp")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS ${library} ${out}/link.rsp)
endfunction()
