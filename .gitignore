# Build output
/build/
/Bin/
/out/
/cmake-build-*/

# IDE / editor
/.vs/
/.idea/
*.user

# OS
.DS_Store
Thumbs.db

# Cooked-resource output database (regenerated by the model importer)
/Data/Output/
.claude/settings.local.json

# Native game module dev output. It lands in the project's SOURCE tree on purpose - the
# manifest's nativeModule points there and that is what the editor loads (game-native-code.md),
# so the build artifacts sit beside the two tracked files (CMakeLists.txt + <T>Plugin.cpp).
**/Native/*.so
**/Native/*.dll
**/Native/*.dylib
**/Native/*.lib
**/Native/*.exp
**/Native/*.pdb
**/Native/*.ilk

# Test-written scratch data (content DBs, cooked projects, temp outputs)
/.test-scratch/
.test-scratch/

Dist/

# A project's caches (its cook database, import ledger, thumbnails, export builds), wherever it is.
.cache/

# What the editor writes into a sample's Code folder for an outside editor as the project opens (each
# language's declarations, the VS Code files): generated from the engine, so not kept.
Data/SampleProjects/*/Code/as.predefined
Data/SampleProjects/*/Code/engine.d.luau
Data/SampleProjects/*/Code/.vscode/
Documentation/Parity/

# Editor/game distribution output (scripts/build-editor-dist.sh, build-export-templates)
/dist/

# The cooked engine shader pack in the data root (Tools.ShaderPack output; a build product).
/Data/Engine/Shaders/shaders.dpak

# Gradle's per-project state (the Android app's Gradle project); its build goes under /build/.
.gradle/
