<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# side of CSharp.Foundation.Tests: the entry point the host test calls. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <!-- The generated bindings and the bridge they call, passed in by the test's CMake. -->
  <ItemGroup>
    <Compile Include="$(EngineBindings)" Condition="'$(EngineBindings)' != ''" />
    <Compile Include="$(EngineBridge)" Condition="'$(EngineBridge)' != ''" />
    <Compile Include="$(EngineValueMath)" Condition="'$(EngineValueMath)' != ''" />
  </ItemGroup>
</Project>
