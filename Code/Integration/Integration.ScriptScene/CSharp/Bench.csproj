<Project Sdk="Microsoft.NET.Sdk">
  <!-- The script speed measures' C# classes, over the engine's runtime. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- The runtime the engine already holds: referenced, not copied. -->
    <Reference Include="Engine.Runtime">
      <HintPath>$(EngineRuntime)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
